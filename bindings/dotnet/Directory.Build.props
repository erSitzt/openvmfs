<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <Authors>OpenVmfs contributors</Authors>
    <Product>OpenVmfs</Product>
    <VersionPrefix>0.3.0</VersionPrefix>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/erSitzt/openvmfs</RepositoryUrl>
    <PackageProjectUrl>https://github.com/erSitzt/openvmfs</PackageProjectUrl>
    <Copyright>Copyright (c) OpenVmfs contributors</Copyright>
    <!-- Root of the repository, where cargo puts the native library. -->
    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</RepoRoot>
  </PropertyGroup>
</Project>
