<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>OpenVmfs</PackageId>
    <Description>Read-only access to VMware VMFS6 volumes and the virtual disks (VMDK) stored on them, without ESXi.</Description>
    <PackageTags>vmfs;vmdk;vmware;esxi;backup</PackageTags>
    <!-- Where cargo put the native libraries; tools/pack-nuget.sh points this at its own build. -->
    <NativeRoot Condition="'$(NativeRoot)' == ''">$(RepoRoot)target/</NativeRoot>
  </PropertyGroup>

  <!--
    The native library is built by cargo (`cargo build -release -p openvmfs-capi`). It is copied next to the
    assembly for local runs and tests, and packed under runtimes/<rid>/native for NuGet.
  -->
  <ItemGroup>
    <None Include="$(NativeRoot)release/libopenvmfs_c.so"
          Condition="Exists('$(NativeRoot)release/libopenvmfs_c.so')"
          Link="libopenvmfs_c.so" CopyToOutputDirectory="PreserveNewest"
          Pack="true" PackagePath="runtimes/linux-x64/native" />
    <None Include="$(NativeRoot)x86_64-pc-windows-gnu/release/openvmfs_c.dll"
          Condition="Exists('$(NativeRoot)x86_64-pc-windows-gnu/release/openvmfs_c.dll')"
          Link="openvmfs_c.dll" CopyToOutputDirectory="PreserveNewest"
          Pack="true" PackagePath="runtimes/win-x64/native" />
    <None Include="$(RepoRoot)LICENSE" Pack="true" PackagePath="" />
    <None Include="$(RepoRoot)NOTICE" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
